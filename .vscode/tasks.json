{
  "version": "2.0.0",
  "tasks": [
    {
      // Started automatically by the "Play (dev)" launch config: `vibe dev`, whose paths
      // Vite reports relative to the project.
      "label": "vite: dev",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(.*\\.(?:ts|js|css)):(\\d+):(\\d+)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*(ready in|Local:).*"
        }
      }
    },
    {
      "label": "vite: preview",
      "type": "shell",
      "command": "npm run build:debug && npm run preview",
      "isBackground": true,
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$", "file": 1, "line": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(vite|building).*",
          "endsPattern": ".*Local:.*"
        }
      }
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
